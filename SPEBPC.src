$ACTION
Case ACTION
 When Default
Endcase

# EDI de ventas de AZETA
If func AFNC.ACTIV("ZEDIV")
   Gosub ACTION From ZSPEBPC_ZEDIV
Endif

Gosub ACTION From ZINTOBJ
Return

Subprog D_ZDOC(VALEUR)
Variable Clbfile VALEUR
End


