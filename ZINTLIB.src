$DEF_TBL_INT
If PZTABLA1<>""          Then Local File =PZTABLA1    [ZCAB]     Endif
If PZTABLA2<>""          Then Local File =PZTABLA2    [ZLIN]     Endif
If clalev([F:ZZPIA])<=0  Then Local File ZBPSINVLIGA  [F:ZZPIA]  Endif
Return

