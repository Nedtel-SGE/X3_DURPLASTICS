#<AdxTL>@(#)0.0.0.0 $Revision$
# Prueba sincronizacion Eclipse - 2026-10-05 16:46:48
#######################################################################################
# Fuente.....: ZINTLIB  -  Librería de funciones comunes interfaz X3
#######################################################################################
# ÍNDICE DE FUNCIONES
#
# Pantalla
#  LLENAR_REJ_MENSAJES         (Subprog)  Carga en la rejilla de la pantalla los mensajes
#                                         activos de una aplicación para un sentido dado
#                                         (ZDEFAPPD + ZDEFSMS)
#
# Etiquetas (Gosub)
#  $DEF_TBL_INT                           Abre las tablas de cabecera/línea de la interfaz
#                                         (PZTABLA1/PZTABLA2) y ZBPSINVLIGA
#  $DEF_TBL_STD                           Abre las tablas estándar X3 usadas por la interfaz
#                                         (fabricación, compras, stock, facturas)
#  $DEF_VAR_CFGSMS                        Declara las variables de configuración de un mensaje
#
# Mensajes y estados de integración
#  UPD_EST_SMS                 (Subprog)  Actualiza estado, traza, mensaje, nº de intentos y
#                                         ruta del XML de un registro de la tabla de interfaz
#  GET_INFO_SMS                (Subprog)  Devuelve la descripción de un mensaje (ZDEFSMS)
#  GET_HEADER_VAL_MSG          (Funprog)  Devuelve el valor de un parámetro de cabecera de un
#                                         mensaje (ZHEADPAR/ZHEADVAL de ZDEFSMS)
#
# Configuración de aplicaciones
#  GET_TIPO_CONEXION           (Subprog)  Devuelve el tipo de conexión de una aplicación
#                                         (ZDEFAPPH)
#  GET_PARAM_VAL_APP           (Funprog)  Devuelve el valor de un parámetro/token de una
#                                         aplicación (ZTOKPAR/ZTOKVAL de ZDEFAPPH)
#
# Ficheros y FTP
#  COPIE_DEL_FILES             (Subprog)  Copia los CSV de una carpeta a otra y después los
#                                         renombra (quita prefijo hasta "_") o los borra
#  GET_PUT_FICHEROS_FTP        (Subprog)  Sube (PUT) o descarga (GET) ficheros de un FTP/SFTP
#                                         mediante WinSCP; en GET renombra en origen a .tra
#
# Fabricación
#  GET_STU_ITMREF              (Funprog)  Devuelve la unidad de stock de un material de una
#                                         OF (MFGMAT)
#  GET_DESC_SEGUIMIENTO        (Funprog)  Devuelve la descripción de operación de un
#                                         seguimiento por Id externo (ZMFGOPETRKD)
#  UPD_SEGUIMIENTO_PREPARACION (Subprog)  Asigna el nº de seguimiento a las preparaciones
#                                         (ZPREPH) de una OF que aún no lo tienen
#
# Consultas genéricas
#  GET_FIELD_VALUE_TBL         (Funprog)  Devuelve el valor de un campo de cualquier tabla
#                                         con una cláusula WHERE libre
#
# Enlace X3 <-> sistema externo (ZINTOBJ)
#  CRE_UPD_REGISTRO_ZINTOBJ    (Subprog)  Crea o actualiza el enlace App/Objeto/Id X3 con el
#                                         Id externo, mensaje y 10 propiedades
#  DEL_REGISTRO_ZINTOBJ        (Subprog)  Borra el enlace cuando se elimina el registro X3
#                                         (en facturas BIS, solo si ya no existe)
#
# Web services y JSON
#  GET_WS_HTTP                 (Subprog)  Llama a un WS externo con ASYRWEBSER.EXEC_HTTP y
#                                         devuelve cabecera, cuerpo y código de estado
#  ZADDJSON                    (Subprog)  Añade un texto a un CLOB escapado como string JSON
#
# Utilidades
#  ESC_SQL                     (Funprog)  Escapa un literal para SQL (duplica apóstrofos)
#  ZURLENC                     (Funprog)  Codifica un texto para URL (usuario/clave WinSCP)
#######################################################################################
# Revisión 24/09/2026
#  - UPD_EST_SMS / LLENAR_REJ_MENSAJES / UPD_SEGUIMIENTO_PREPARACION / DEL_REGISTRO_ZINTOBJ:
#    los literales SQL se escapan con ESC_SQL (apóstrofos)
#  - GET_PUT_FICHEROS_FTP: eliminada credencial en claro, script WinSCP escrito
#    directamente (sin echo), contraseña URL-encoded, ficheros temporales borrados,
#    validación de tipo de conexión antes de abrir ficheros
#  - COPIE_DEL_FILES: eliminada variable LFICMOV no declarada
#  - CRE_UPD_REGISTRO_ZINTOBJ: transacción + Readlock, ZCODSMS/ZIDENL correctos,
#    fecha homogénea, mensaje de error corregido
#  - DEL_REGISTRO_ZINTOBJ: borrado filtrado también por objeto
#  - GET_PARAM_VAL_APP / GET_HEADER_VAL_MSG: solo cierran la tabla si la abren ellas,
#    control de fstat
#  - GET_STU_ITMREF: se libera el Filter
#  - ZADDJSON: escapa todos los caracteres de control (< 0x20)
#  - Nuevas utilidades: ESC_SQL, ZURLENC
#  - Eliminadas variables sin uso
#######################################################################################

#**
#* Rellena los mensajes en el cuadro de la pantalla
#*
#* @param PZAPLICACION > Aplicación
#* @param PZSENTIDO    > Sentido del mensaje
#* @param PZABREV      > Abreviatura de la pantalla
#*!
Subprog LLENAR_REJ_MENSAJES(PZAPLICACION,PZSENTIDO,PZABREV)
Value Char    PZAPLICACION
Value Integer PZSENTIDO
Value Char    PZABREV
Local Integer FILA  : FILA=-1
Local Integer TF

If dim([M:ZIM0]ZSEL)>=0 Then
  TF=dim([M:ZIM0]ZSEL)-1
Else
  TF=dim([M:ZDIA]ZSEL)-1
Endif

PZABREV="[M:"+PZABREV+"]"

Gosub DEF_VAR_SQL From ZCOMUN
F+=1 : TXT(F)="SELECT ZA.ZCODSMS_0,ZDESSMS_0 FROM ZDEFAPPD ZA "
F+=1 : TXT(F)="INNER JOIN ZDEFSMS ZS ON ZA.ZCODSMS_0=ZS.ZCODSMS_0 "
F+=1 : TXT(F)="WHERE ZA.ZCODAPP_0='"+func ESC_SQL(PZAPLICACION)+"' AND ZA.ZACTSMS_0=2 AND ZS.ZSENTIDO_0="+num$(PZSENTIDO)
For (Char ZCODSMS(GLONZSMS),Char ZDESSMS(50)) From BD Sql TXT As [ZREG]
  If FILA+2>=TF
    Call ERREUR ("FALTAN DATOS !!!\Se ha alcanzado el máximo de"-num$(TF)-"filas en rejilla mensajes\Pida que se lo aumenten") From GESECRAN
    Break
  Else
    FILA+=1
    Assign PZABREV+"ZIDSMS(FILA)"   With [ZREG]ZCODSMS
    Assign PZABREV+"ZDESCSMS(FILA)" With [ZREG]ZDESSMS
  Endif
Next

Assign PZABREV+"NBLIG" With FILA+1
End

