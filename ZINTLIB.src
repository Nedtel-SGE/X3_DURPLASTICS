If clalev([F:ZTST])<=0  Local File TABSTASTO  [F:ZTST] Endif
If clalev([F:ZMKI])<=0  Local File MFGITMTRK  [F:ZMKI] Endif
If clalev([F:MKI])<=0   Local File MFGITMTRK  [F:MKI]  Endif
If clalev([F:ZMKM])<=0  Local File MFGMATTRK  [F:ZMKM] Endif
If clalev([F:MKM])<=0   Local File MFGMATTRK  [F:MKM]  Endif
If clalev([F:ZPOH])<=0  Local File PORDER     [F:ZPOH] Endif
If clalev([F:SMH])<=0   Local File SMVTH      [F:SMH]  Endif
If clalev([F:SGH])<=0   Local File SCHGH      [F:SGH]  Endif
If clalev([F:ZSGH])<=0  Local File SCHGH      [F:ZSGH] Endif
If clalev([F:PTH])<=0   Local File PRECEIPT   [F:PTH]  Endif
If clalev([F:ZPOQ])<=0  Local File PORDERQ    [F:ZPOQ] Endif
If clalev([F:ZPOP])<=0  Local File PORDERP    [F:ZPOP] Endif
If clalev([F:ZMFI])<=0  Local File MFGITM     [F:ZMFI] Endif
If clalev([F:ZMKO])<=0  Local File MFGOPETRK  [F:ZMKO] Endif
If clalev([F:MKO])<=0   Local File MFGOPETRK  [F:MKO]  Endif
If clalev([F:PIH])<=0   Local File PINVOICE   [F:PIH]  Endif
If clalev([F:ZPIH])<=0  Local File PINVOICE   [F:ZPIH] Endif

Return

